@model infass_Jimenez_A1.Models.User



<div class="container" style="margin-top: 20px;">
    <div class="panel panel-primary">
        <div class="row panel-heading">
            <p style="margin-top: 20px;">
                <div class="text-end">
                    @*<select id="select" class="form-select">
                        <option selected>Select...</option>
                        <option value="1">User</option>
                    </select>*@
                    <button id="btnShowUser" type="button" class="btn btn-dark">Show All User</button>
                </div>
            </p>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th> @Html.DisplayNameFor(model => model.Email)</th>
                        <th> @Html.DisplayNameFor(model => model.Age)</th>
                        <th> @Html.DisplayNameFor(model => model.Password)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>

            <div>
                <button id="AddNew" type="button" class="btn btn-secondary">
                    Add New
                </button>
            </div>
        </div>
    </div>
</div>
















